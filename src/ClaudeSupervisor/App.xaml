<Application x:Class="ClaudeSupervisor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- App logo: Claude's clay sunburst with an engineer's gear ("directing it to work").
             Pure vector so it needs no image asset; used for the header and the window icon. -->
        <DrawingImage x:Key="AppLogo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- Rounded clay background -->
                    <GeometryDrawing Brush="#CC785C">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Sunburst rays -->
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="0" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="30" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="60" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="90" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="120" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="150" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="180" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="210" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="240" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="270" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="300" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="30.7,7,2.6,15" RadiusX="1.3" RadiusY="1.3"><RectangleGeometry.Transform><RotateTransform Angle="330" CenterX="32" CenterY="32" /></RectangleGeometry.Transform></RectangleGeometry>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="32,32" RadiusX="4.5" RadiusY="4.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Engineer's gear (dark), lower-right -->
                    <GeometryDrawing Brush="#1F2430">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="0" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="45" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="90" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="135" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="180" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="225" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="270" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <RectangleGeometry Rect="46.5,37,3,5"><RectangleGeometry.Transform><RotateTransform Angle="315" CenterX="48" CenterY="48" /></RectangleGeometry.Transform></RectangleGeometry>
                                <EllipseGeometry Center="48,48" RadiusX="7.5" RadiusY="7.5" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#CC785C">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="48,48" RadiusX="3.2" RadiusY="3.2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Simple flat button style used across the window. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D6CDF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E5AC8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#9AB4E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
