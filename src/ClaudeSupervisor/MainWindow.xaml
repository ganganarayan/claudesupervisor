<Window x:Class="ClaudeSupervisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Supervisor"
        Height="860" Width="770"
        MinHeight="740" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        Icon="{StaticResource AppLogo}"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="{StaticResource AppLogo}" Width="44" Height="44" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Claude Supervisor" FontSize="22" FontWeight="SemiBold" Foreground="#1B2430" />
                    <TextBlock x:Name="VersionText" Text="" FontSize="12" Foreground="#7A8598"
                               VerticalAlignment="Bottom" Margin="10,0,0,4" />
                </StackPanel>
                <TextBlock Text="Reads the reset time off a usage-limit message and auto-sends when the limit is back (IST)."
                           FontSize="12.5" Foreground="#5B6676" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- Target window -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE1EA" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Target 1 (Claude):" FontWeight="SemiBold" Foreground="#1B2430" VerticalAlignment="Center" />
                <TextBlock x:Name="TargetText" Grid.Column="1" Text="Not detected" Margin="8,0,0,0"
                           Foreground="#5B6676" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="DetectButton" Grid.Column="2" Content="Re-detect" Click="DetectButton_Click"
                        Background="#5B6676" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Second target -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE1EA" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SecondTargetCheck" Grid.Column="0" Content="Also send to 2nd window:"
                          VerticalAlignment="Center" Foreground="#1B2430" FontWeight="SemiBold"
                          Checked="SecondTargetCheck_Changed" Unchecked="SecondTargetCheck_Changed" />
                <TextBlock x:Name="SecondTargetText" Grid.Column="1" Text="none picked" Margin="8,0,0,0"
                           Foreground="#5B6676" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="PickWindowButton" Grid.Column="2" Content="Pick window…" Click="PickWindowButton_Click"
                        Background="#5B6676" Margin="8,0,0,0" IsEnabled="False" />
            </Grid>
        </Border>

        <!-- Reset time -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Reset time:" VerticalAlignment="Center" Foreground="#1B2430" />
            <TextBox x:Name="ResetTimeBox" Grid.Column="1" Margin="8,0,0,0"
                     Padding="6,4" VerticalContentAlignment="Center"
                     TextChanged="ResetTimeBox_TextChanged"
                     ToolTip="IST. e.g. 3pm, 3:00 PM, or 15:00. Filled in by 'Read reset time', or type it yourself." />
            <Button x:Name="ReadButton" Grid.Column="2" Content="Read reset time (OCR)"
                    Click="ReadButton_Click" Margin="10,0,0,0" />
            <TextBlock Grid.Column="3" Text="Buffer (sec):" VerticalAlignment="Center"
                       Foreground="#1B2430" Margin="16,0,0,0"
                       ToolTip="Extra seconds to wait after the reset time before sending." />
            <TextBox x:Name="BufferBox" Grid.Column="4" Text="30" Margin="8,0,0,0"
                     Padding="6,4" VerticalContentAlignment="Center" />
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <CheckBox x:Name="EnterOnlyCheck" Content="Just press Enter (prompt already typed in Claude)"
                      VerticalAlignment="Center" Foreground="#1B2430"
                      Checked="EnterOnlyCheck_Changed" Unchecked="EnterOnlyCheck_Changed"
                      ToolTip="When ticked, the app only presses Enter and ignores the text box (attachments are still pasted)." />
            <CheckBox x:Name="SleepWhenDoneCheck" Content="Sleep the PC when done"
                      VerticalAlignment="Center" Foreground="#1B2430" Margin="24,0,0,0"
                      ToolTip="After sending, put the machine to sleep. While armed the PC + display are kept awake so Claude stays interactable." />
        </StackPanel>

        <!-- Send text -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="Send text (appended to whatever is in Claude's box, then Enter):"
                       Foreground="#1B2430" Margin="0,0,0,4" />
            <TextBox x:Name="SendTextBox" Text="resume"
                     Height="80" Padding="8" AcceptsReturn="True" AcceptsTab="False"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     ToolTip="Leave empty to just press Enter. Multi-line text uses Shift+Enter for line breaks and a final Enter to submit." />
        </StackPanel>

        <!-- Attachments -->
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock Text="Attachments (pasted into Claude via Ctrl+V, before the prompt):"
                       Foreground="#1B2430" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#DCE1EA" BorderThickness="1" CornerRadius="5" Background="White">
                    <ListBox x:Name="AttachmentsList" Height="66" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button x:Name="AddFilesButton" Content="Add files…" Click="AddFilesButton_Click"
                            Background="#5B6676" Margin="0,0,0,6" />
                    <Button x:Name="RemoveFileButton" Content="Remove" Click="RemoveFileButton_Click"
                            Background="#5B6676" Margin="0,0,0,6" />
                    <Button x:Name="ClearFilesButton" Content="Clear" Click="ClearFilesButton_Click"
                            Background="#5B6676" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="ArmButton" Content="Arm / Schedule" Click="ArmButton_Click"
                    Background="#2E9E5B" Padding="18,8" FontWeight="SemiBold" />
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                    Background="#5B6676" Padding="16,8" IsEnabled="False" />
            <Button x:Name="ResumeNowButton" Content="Send now (test)" Click="ResumeNowButton_Click"
                    Background="#2D6CDF" Padding="16,8" />
        </StackPanel>

        <!-- Big status -->
        <Border Grid.Row="8" Background="#EAF1FF" BorderBrush="#C9DBFF" BorderThickness="1"
                CornerRadius="6" Padding="14,12" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="Idle. Detect the Claude window, then read or enter the reset time."
                       FontSize="14" Foreground="#1B3A72" TextWrapping="Wrap" />
        </Border>

        <!-- Log -->
        <Border Grid.Row="9" Background="#1B2430" CornerRadius="6" Margin="0,14,0,0">
            <TextBox x:Name="LogBox" Background="Transparent" Foreground="#D6E2F5"
                     BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"
                     VerticalContentAlignment="Top" MinHeight="90" />
        </Border>

        <TextBlock Grid.Row="10" Margin="2,8,0,0" FontSize="11" Foreground="#9AA4B2"
                   Text="Keep the Claude window open and the PC unlocked. At send time the app briefly brings each window to the foreground to paste/type."
                   TextWrapping="Wrap" />
    </Grid>
</Window>
