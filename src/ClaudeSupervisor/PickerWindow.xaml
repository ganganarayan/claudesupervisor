<Window x:Class="ClaudeSupervisor.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a window"
        Height="440" Width="560"
        MinHeight="320" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        Icon="{StaticResource AppLogo}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#1B2430"
                   Text="Select the window to use as the second target (e.g. the terminal running Claude Code)." />

        <Border Grid.Row="1" BorderBrush="#DCE1EA" BorderThickness="1" CornerRadius="6" Background="White">
            <ListBox x:Name="WindowList" BorderThickness="0" Background="Transparent"
                     DisplayMemberPath="Display" MouseDoubleClick="WindowList_MouseDoubleClick" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Click="Refresh_Click" Background="#5B6676" Padding="14,7" />
            <Button Content="Cancel" Click="Cancel_Click" Background="#5B6676" Padding="14,7" />
            <Button Content="Select" Click="Select_Click" Background="#2D6CDF" Padding="16,7" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
